{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "SurefyOS shared packages (contracts, ui, web-core, ml-client)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true
  }
}
