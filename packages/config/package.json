{
  "name": "@surefy/config",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Shared tsconfig bases, ESLint flat configs (base, node, next, package) and the Prettier config",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "eslint-config-next": "16.3.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.13.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript-eslint": "8.71.0"
  },
  "peerDependencies": {
    "eslint": "^10.12.0",
    "prettier": "^3.9.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
