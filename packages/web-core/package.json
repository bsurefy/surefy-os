    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "nuqs": "2.10.1",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "next": "^16.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@surefy/config": "workspace:*",
