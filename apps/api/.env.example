# SurefyOS API and worker: every variable the backend reads (core/config/env.ts).
# Copy to .env.local for development; production gets its environment from the deployment.
# Placeholders only. Never commit a real .env file.

# --- Application -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=SurefyOS
# Public API URL for machine clients, the widget and webhooks (CORS answers on this host only).
API_PUBLIC_URL=http://localhost:4000
# Workspace web app origin; Console and Partner origins exist only on SurefyOS Cloud.
APP_ORIGIN=http://localhost:3000
# CONSOLE_ORIGIN=https://console.example.com
# PARTNER_ORIGIN=https://partner.example.com
# Extra allowed origins for the public API host, comma-separated (widget hosts are per agent).
PUBLIC_CORS_ORIGINS=
API_HOST=0.0.0.0
API_PORT=4000
# OpenAPI docs at /api/docs: always on in development; opt in for production.
API_DOCS_ENABLED=false
# Fastify trustProxy: proxy IPs/CIDRs, a hop count, "loopback", or true/false.
TRUST_PROXY=loopback
# Worker health endpoints, internal only.
WORKER_HEALTH_PORT=4001
# Jobs processed at once per queue by the worker.
WORKER_CONCURRENCY=5
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Database and Redis -----------------------------------------------------------------------
# The app connects as surefy_app (row-level security enforced).
DATABASE_URL=postgres://surefy_app:change-me@127.0.0.1:54320/surefy
# Migrations connect as surefy_owner; required only by `pnpm db:migrate`.
DATABASE_MIGRATION_URL=postgres://surefy_owner:change-me@127.0.0.1:54320/surefy
DATABASE_POOL_SIZE=10
REDIS_URL=redis://127.0.0.1:63790

# --- Secrets (generate with `openssl rand -base64 32`) ---------------------------------------
# Signs sessions; at least 32 characters.
AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Master key for envelope encryption; exactly 32 bytes, base64. Losing it makes stored keys unrecoverable.
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# One-time token for the first-run setup; at least 16 characters.
# SETUP_TOKEN=replace-with-a-random-setup-token

# --- ML service (internal) -------------------------------------------------------------------
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TOKEN=replace-with-a-random-string-of-at-least-32-characters

# --- Storage: local (default) or s3 ---------------------------------------------------------
STORAGE_DRIVER=local
# Mounted volume for the local driver.
STORAGE_LOCAL_PATH=./data/storage
# S3-compatible driver (AWS S3, Cloudflare R2, MinIO); required only when STORAGE_DRIVER=s3.
# STORAGE_S3_BUCKET=surefy
# STORAGE_S3_REGION=auto
# STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
# STORAGE_S3_FORCE_PATH_STYLE=true
# STORAGE_S3_ACCESS_KEY_ID=replace-me
# STORAGE_S3_SECRET_ACCESS_KEY=replace-me

# --- Mail: console (default) or smtp --------------------------------------------------------
MAIL_DRIVER=console
MAIL_FROM="SurefyOS <no-reply@localhost>"
# SMTP driver; required only when MAIL_DRIVER=smtp.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- OAuth sign-in (optional; a provider is on when both values are set) --------------------
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_TENANT_ID=common
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# --- OpenTelemetry (optional; read by the SDK itself in core/telemetry) ---------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=surefy-api
