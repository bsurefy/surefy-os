{
  "name": "@surefy/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "API server and background worker",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env.local src/worker.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "cli": "tsx --env-file-if-exists=.env.local src/cli.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/database/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/google": "4.0.87",
    "@ai-sdk/openai": "4.0.83",
    "@ai-sdk/openai-compatible": "3.0.62",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@scalar/fastify-api-reference": "1.72.4",
    "@surefy/contracts": "workspace:*",
    "@surefy/ml-client": "workspace:*",
    "ai": "7.0.127",
    "better-auth": "1.7.7",
    "bullmq": "6.3.11",
    "close-with-grace": "2.5.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "nodemailer": "10.0.13",
    "openapi-types": "12.1.3",
    "pg": "8.23.1",
    "pgvector": "0.3.0",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@surefy/config": "workspace:*",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "pino-pretty": "13.1.3",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
