    "ai": "7.0.127",
    "better-auth": "1.7.7",
    "lucide-react": "1.50.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@surefy/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
