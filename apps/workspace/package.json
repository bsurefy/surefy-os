{
  "name": "@surefy/workspace",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Workspace web app (app.surefyos.com)",
  "scripts": {
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "dev:mock": "tsx watch --env-file-if-exists=.env.local mock/main.ts",
