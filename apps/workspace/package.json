    "start": "next start --port ${WEB_PORT:-3000}",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.130",
    "@surefy/contracts": "workspace:*",
    "@surefy/ui": "workspace:*",
    "@surefy/web-core": "workspace:*",
