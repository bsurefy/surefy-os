{
  "components": {
    "schemas": {
      "DocumentSection": {
        "additionalProperties": false,
        "properties": {
          "headingPath": {
            "items": {
              "type": "string"
            },
            "title": "Headingpath",
            "type": "array"
          },
          "pageFrom": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pagefrom"
          },
          "pageTo": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pageto"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "headingPath",
          "text",
          "pageFrom",
          "pageTo"
        ],
        "title": "DocumentSection",
        "type": "object"
      },
      "DocumentTable": {
        "additionalProperties": false,
        "properties": {
          "caption": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Caption"
          },
          "headingPath": {
            "items": {
              "type": "string"
            },
            "title": "Headingpath",
            "type": "array"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "rows": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Rows",
            "type": "array"
          }
        },
        "required": [
          "headingPath",
          "caption",
          "rows",
          "page"
        ],
        "title": "DocumentTable",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "title": "Requestid",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HealthStatus": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "OcrMode": {
        "enum": [
          "auto",
          "force",
          "off"
        ],
        "title": "OcrMode",
        "type": "string"
      },
      "ParseDocumentRequest": {
        "additionalProperties": false,
        "properties": {
          "fileUrl": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Fileurl",
            "type": "string"
          },
          "maxPages": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maxpages"
          },
          "mimeType": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Mimetype",
            "type": "string"
          },
          "ocr": {
            "$ref": "#/components/schemas/OcrMode",
            "default": "auto"
          },
          "orgId": {
            "format": "uuid",
            "title": "Orgid",
            "type": "string"
          }
        },
        "required": [
          "fileUrl",
          "mimeType",
          "orgId"
        ],
        "title": "ParseDocumentRequest",
        "type": "object"
      },
      "ParsedDocument": {
        "additionalProperties": false,
        "properties": {
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "pages": {
            "title": "Pages",
            "type": "integer"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/DocumentSection"
            },
            "title": "Sections",
            "type": "array"
          },
          "tables": {
            "items": {
              "$ref": "#/components/schemas/DocumentTable"
            },
            "title": "Tables",
            "type": "array"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "usedOcr": {
            "title": "Usedocr",
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "language",
          "pages",
          "sections",
          "tables",
          "usedOcr"
        ],
        "title": "ParsedDocument",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "SurefyOS ML service",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/documents/parse": {
      "post": {
        "operationId": "parse_document_v1_documents_parse_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseDocumentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParsedDocument"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Parse Document",
        "tags": [
          "documents"
        ]
      }
    }
  }
}
