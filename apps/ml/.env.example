# SPDX-License-Identifier: AGPL-3.0-only
# Every ML_ variable of the ML service. Copy to .env.local for development.
ML_ENV=development
ML_LOG_LEVEL=info
# Shared secret with the backend (ML_SERVICE_TOKEN there too); at least 32 characters.
ML_SERVICE_TOKEN=replace-with-a-random-value-of-32-or-more-characters
# JSON list of host[:port] the service may download signed URLs from.
ML_ALLOWED_DOWNLOAD_HOSTS=["localhost:4000"]
