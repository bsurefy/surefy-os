# Every ML_ variable of the ML service. Copy to .env.local for development.
ML_ENV=development
ML_LOG_LEVEL=info
# Shared secret with the backend (ML_SERVICE_TOKEN there too); at least 32 characters.
ML_SERVICE_TOKEN=replace-with-a-random-value-of-32-or-more-characters
# JSON list of host[:port] the service may download signed URLs from.
ML_ALLOWED_DOWNLOAD_HOSTS=["localhost:4000"]

# Per-request limits.
ML_MAX_FILE_BYTES=104857600
ML_MAX_PAGES=2000
ML_PARSE_TIMEOUT_SECONDS=600
ML_DOWNLOAD_TIMEOUT_SECONDS=60

# Worker pool: processes, wait for a free worker, running tasks per organization.
ML_WORKERS=2
ML_QUEUE_TIMEOUT_SECONDS=30
ML_MAX_CONCURRENT_PER_ORG=2

# Pre-downloaded model weights (images use /models). For local development:
#   uv run docling-tools models download layout tableformer rapidocr -o .models
ML_MODELS_DIR=.models
ML_DEVICE=cpu
